{
  "$comment": "Tier rules for scripts/build-assets.mjs. First matching rule wins. 'match' is a regex on the asset id (filename without .glb).",
  "tiers": {
    "HERO": { "trisMin": 20000, "trisMax": 60000, "texMax": 1024, "error": 0.001, "maxBytes": 2621440, "lods": [1, 0.35, 0.1] },
    "PART": { "trisMin": 3000, "trisMax": 15000, "texMax": 512, "error": 0.003, "maxBytes": 1048576, "lods": [1] },
    "PROP": { "trisMin": 5000, "trisMax": 25000, "texMax": 512, "error": 0.005, "maxBytes": 1572864, "lods": [1, 0.35, 0.1] },
    "FILL": { "trisMin": 500, "trisMax": 4000, "texMax": 256, "error": 0.01, "maxBytes": 262144, "lods": [1] }
  },
  "rules": [
    { "match": "^engineAssembly_", "tier": "HERO", "category": "engine" },
    { "match": "^carFrame_", "tier": "HERO", "category": "frame" },
    { "match": "^bodyPart_", "tier": "HERO", "category": "body" },
    { "match": "^wheelAssembly_", "tier": "HERO", "category": "wheel" },
    { "match": "^engineComponent_", "tier": "PART", "category": "engineComponent" },
    { "match": "^suspension_", "tier": "PART", "category": "suspension" },
    { "match": "^brakeSystem_", "tier": "PART", "category": "brake" },
    { "match": "^drivetrain_", "tier": "PART", "category": "drivetrain" },
    { "match": "^exhaustSystem_", "tier": "PART", "category": "exhaust" },
    { "match": "^steeringSystem_", "tier": "PART", "category": "steering" },
    { "match": "^interiorPart_", "tier": "PART", "category": "interior" },
    { "match": "^vehicleSupport_", "tier": "PROP", "category": "vehicleSupport" },
    { "match": "^serviceTool_(engine_hoist|engine_stand|waste_oil_tank|drainPan)", "tier": "PROP", "category": "serviceTool" },
    { "match": "^tireTool_", "tier": "PROP", "category": "tireTool" },
    { "match": "^powerTool_welding", "tier": "PROP", "category": "powerTool" },
    { "match": "^(rack|storage)_", "tier": "PROP", "category": "storage" },
    { "match": "^structure_", "tier": "PROP", "category": "structure" },
    { "match": "^lighting_", "tier": "FILL", "category": "lighting" },
    { "match": "^(pallet|drum|paint|barrier|fireExtinguisher|ladder|handTruck|handTool|sign|serviceTool|powerTool|warehouse|monitor|computer)_", "tier": "FILL", "category": "fill" }
  ],
  "massClamps": {
    "engineAssembly_v6": [150, 190],
    "engineAssembly_v8": [180, 230],
    "engineAssembly_v12": [230, 290],
    "engineAssembly_electric": [70, 110],
    "bodyPart_.*hood": [12, 25],
    "bodyPart_.*door": [18, 35],
    "bodyPart_.*fender": [3, 9],
    "bodyPart_.*bumper": [4, 12],
    "bodyPart_.*trunk": [8, 18],
    "bodyPart_": [1, 40],
    "wheelAssembly_": [18, 28],
    "carFrame_": [250, 420],
    "brakeSystem_": [3, 15],
    "suspension_": [4, 25],
    "drivetrain_.*transmission": [40, 90],
    "drivetrain_": [8, 60],
    "exhaustSystem_": [6, 30],
    "engineComponent_.*turbo": [6, 20],
    "engineComponent_.*supercharger": [10, 25],
    "engineComponent_": [0.2, 30],
    "interiorPart_.*seat": [12, 30],
    "interiorPart_": [0.5, 25]
  }
}
